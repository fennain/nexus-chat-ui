{
  "name": "nexus-chat-ui",
  "version": "0.1.3",
  "description": "A React 19 chat component with built-in WebSocket logic, built with Chatscope, Vite, and TypeScript.",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "license": "MIT",
  "keywords": [
    "react",
    "react19",
    "chat",
    "chat-ui",
    "im",
    "chatscope",
    "typescript",
    "vite"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --force",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@chatscope/chat-ui-kit-react": "^2.1.1",
    "@chatscope/chat-ui-kit-styles": "^1.4.0",
    "@douyinfe/semi-ui": "^2.97.0",
    "axios": "^1.16.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "lodash": "4.18.1",
    "react-responsive": "^10.0.1",
    "tailwind-merge": "^3.6.0",
    "tdesign-icons-react": "^0.6.4",
    "tdesign-mobile-react": "^0.22.0",
    "use-context-selector": "^2.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.7"
  }
}
